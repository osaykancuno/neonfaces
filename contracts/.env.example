# --- RPC / verification ---
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
BLOCKSCOUT_API_KEY=blockscout
DEPLOYER_PK=

# --- roles & payees ---
# Solo founder: one Safe 2-of-3 (MetaMask + phone wallet + offline backup key, three different seed phrases) as
# ADMIN, TREASURY and ROYALTY_RECEIVER; GROWTH is a dedicated MetaMask account (payees must differ). The 40% seed
# share goes to NeonSeedVault, deployed by the script: no address needed.
ADMIN=
# wallet that runs the drop in OpenSea Studio (default: ADMIN). It can only configure SeaDrop stages:
# it cannot mint, change the art or redirect proceeds. A dedicated MetaMask account used only in OpenSea Studio;
# clear it after the sale.
SALE_MANAGER=
ROYALTY_RECEIVER=
TREASURY=
GROWTH=
TEAM_BENEFICIARY=
# hot key used by tools/seed-keeper.mjs (holds only gas). It can make the vault buy basket tokens for the pool,
# nothing else. Default: the deployer.
KEEPER=
# VESTING_START=           # unix seconds, default: deploy time
# VESTING_DURATION=15552000  # 180 days

# --- metadata ---
SITE_URL=https://neonfaces.xyz/

# --- testnet / local only ---
USE_MOCK_TOKENS=false
