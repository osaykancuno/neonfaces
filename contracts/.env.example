# it cannot mint, change the art or redirect proceeds. Use a hardware wallet; clear it after the sale.
SALE_MANAGER=
ROYALTY_RECEIVER=
SEED_VAULT=
TREASURY=
GROWTH=
TEAM_BENEFICIARY=
# VESTING_START=           # unix seconds, default: deploy time
# VESTING_DURATION=15552000  # 180 days

# --- metadata ---
SITE_URL=https://neonfaces.xyz/

# --- testnet / local only ---
USE_MOCK_TOKENS=false
