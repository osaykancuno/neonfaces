// neonfaces.xyz from the public stage: the web app (web/dist/) as static assets; every unknown path serves index.html
// (/face/<id>, /sets, ...), like the SPA rewrite in web/dist/_redirects on Netlify. Only /mcp runs the Worker
// (web-worker.mjs: the remote MCP server, 14 Oct); everything else never touches it. Publish: tools/site.sh deploy web
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "neonfaces",
  "compatibility_date": "2026-09-01",
  "main": "web-worker.mjs",
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/mcp/", "/api/*"]
  },
  // the zone's proxied records reach this Worker through these routes (a custom domain would need the records deleted
  // first, leaving a gap; routes keep the records in place). www is redirected to the apex by a zone Redirect Rule.
  "routes": [
    { "pattern": "neonfaces.xyz/*", "zone_name": "neonfaces.xyz" },
    { "pattern": "www.neonfaces.xyz/*", "zone_name": "neonfaces.xyz" }
  ],
  // the chat (/api/ask): free models tried in order (change them here, no code change; 14 Oct: Gemma's free provider
  // was often rate-limited, Inkling refuses websites, Nemotron Super answers in 2-3 s, Ultra in 15-30 s and is often overloaded; openrouter/free = any free model); its OpenRouter key is the
  // secret OPENROUTER_API_KEY, set by the founder with `npx wrangler@4.142.0 secret put OPENROUTER_API_KEY -c tools/cloudflare/web.jsonc`
  "vars": { "ASK_MODELS": "nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openrouter/free" },
  // each visitor (by IP) may ask 6 questions a minute
  "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "4663", "simple": { "limit": 6, "period": 60 } }],
  "workers_dev": true,
  "preview_urls": false
}
