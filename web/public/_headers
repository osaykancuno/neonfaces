# Response headers for the web app (read by Cloudflare, like Netlify before). No other site may frame it (a framed page could trick a click
# before a wallet prompt); browsers must not guess file types; other sites see only the origin in the referrer.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite names every built file after its content (assets/index-<hash>.js): a new build gets new names, so browsers
# and Cloudflare's edge can keep these for a year and a crowd on sale day only fetches index.html and deployment.json
/assets/*
  Cache-Control: public, max-age=31536000, immutable
